# =================================================================
# K-CLICK ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================
# Copy file ini menjadi `.env` di root project untuk development lokal
# atau atur pada panel Environment Variables hosting Anda (Vercel, Cloud Run, VPS, dll).

# -----------------------------------------------------------------
# 1. Branding & Application Settings
# -----------------------------------------------------------------
VITE_APP_NAME="K-Click"
VITE_SUPPORT_EMAIL=""

# -----------------------------------------------------------------
# 2. Firebase Client Configuration
# -----------------------------------------------------------------
# Dapatkan nilai-nilai ini dari:
# Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID="(default)"

# -----------------------------------------------------------------
# 3. Konfigurasi Pembayaran QRIS Manual & Verifikasi Admin
# -----------------------------------------------------------------
# QRIS resmi aplikasi menggunakan aset bawaan /qris-kclick.png
# dengan merchant: K-CLICK, DIGITAL & KREATIF (NMID: ID1026592549699).
# Variabel opsional di bawah ini untuk kustomisasi gambar QRIS tambahan jika diperlukan:
VITE_PAYMENT_QR_IMAGE_URL=""

# -----------------------------------------------------------------
# 4. Server-Side Private Secrets
# -----------------------------------------------------------------
# GEMINI_API_KEY: Digunakan di backend (server.ts) untuk asisten caption dan deskripsi produk
GEMINI_API_KEY=""
APP_URL=""
